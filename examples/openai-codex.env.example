# Hindsight must be the sole refresh owner of independently authorized file credentials.
HINDSIGHT_API_LLM_PROVIDER=openai-codex
HINDSIGHT_API_LLM_MODEL=replace-with-your-entitled-codex-model
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=3
# Existing absolute host directory; no ~, $HOME or OMP credential storage.
HINDSIGHT_OMP_CODEX_AUTH_DIR=/absolute/path/to/dedicated/hindsight-codex
