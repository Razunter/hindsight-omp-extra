# OpenCode Zen pay-as-you-go; choose a paid Messages model with structured output.
HINDSIGHT_API_LLM_PROVIDER=anthropic
HINDSIGHT_API_LLM_MODEL=replace-with-your-bare-messages-model-id
HINDSIGHT_API_LLM_API_KEY=replace-with-your-independent-zen-key
# The Anthropic SDK appends /v1/messages, so this base must exclude /v1.
HINDSIGHT_API_LLM_BASE_URL=https://opencode.ai/inference/anthropic
# Use the same Zen key in API_KEY and this Bearer header; values are literal.
HINDSIGHT_API_LLM_DEFAULT_HEADERS='{"Authorization":"Bearer replace-with-your-independent-zen-key"}'
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=3
