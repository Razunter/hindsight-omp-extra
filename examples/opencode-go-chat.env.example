# Go Chat Completions; choose a bare model ID documented for this protocol.
HINDSIGHT_API_LLM_PROVIDER=opencode-go
HINDSIGHT_API_LLM_MODEL=replace-with-your-bare-chat-model-id
HINDSIGHT_API_LLM_API_KEY=replace-with-your-independent-go-key
HINDSIGHT_API_LLM_BASE_URL=https://opencode.ai/zen/go/v1
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=3
