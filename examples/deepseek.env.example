# Official DeepSeek API: https://api-docs.deepseek.com/
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-flash
HINDSIGHT_API_LLM_API_KEY=replace-with-your-independent-deepseek-api-key
HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com
# DeepSeek supports JSON-object output, not strict JSON-schema response formats.
HINDSIGHT_API_LLM_STRICT_SCHEMA=false
# Disable the model's default thinking mode for memory processing.
HINDSIGHT_API_LLM_REASONING_EFFORT=none
HINDSIGHT_API_LLM_MAX_CONCURRENT=3
