# OpenCode Zen pay-as-you-go; choose a paid Chat model with strict structured output.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=replace-with-your-bare-chat-model-id
HINDSIGHT_API_LLM_API_KEY=replace-with-your-independent-zen-key
HINDSIGHT_API_LLM_BASE_URL=https://opencode.ai/inference/openai/v1
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=3
