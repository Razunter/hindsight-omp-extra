# OpenAI Chat Completions; choose a model supporting strict JSON-schema output.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=replace-with-your-chat-model
HINDSIGHT_API_LLM_API_KEY=replace-with-your-independent-api-key
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=3
