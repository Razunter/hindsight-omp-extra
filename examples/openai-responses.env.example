# OpenAI Responses; choose a model supporting Responses and strict structured output.
HINDSIGHT_API_LLM_PROVIDER=openai-responses
HINDSIGHT_API_LLM_MODEL=replace-with-your-responses-model
HINDSIGHT_API_LLM_API_KEY=replace-with-your-independent-api-key
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_LLM_MAX_CONCURRENT=3
