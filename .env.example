# Shared launcher settings. Copy to .env in the extension root.
# Example values, not implicit defaults. Use names/ports that do not conflict
# with an existing deployment; retain its volume name when migrating.
HINDSIGHT_CONTAINER_NAME=hindsight-omp
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
HINDSIGHT_VOLUME_NAME=hindsight-omp-data
HINDSIGHT_WORKER_ID=hindsight-omp-worker
HINDSIGHT_API_WORKER_MAX_SLOTS=2
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999
# Optional; defaults to 127.0.0.1. Overrides both published ports.
# HINDSIGHT_BIND_ADDRESS=127.0.0.1

# Optional common LLM defaults; the selected provider profile overrides them.
# HINDSIGHT_API_LLM_STRICT_SCHEMA=true
# HINDSIGHT_API_LLM_MAX_CONCURRENT=4
# HINDSIGHT_API_LLM_TIMEOUT=600

# Optional mental-model refresh interval and local embedding model.
# HINDSIGHT_API_MENTAL_MODEL_MIN_REFRESH_INTERVAL_SECONDS=1800
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
# HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=hindsight-ai/hs-embed-1

# Optional decision-model configuration; requires its own authorized API key.
# HINDSIGHT_API_DECISION_MODEL_PROVIDER=typesafe
# HINDSIGHT_API_DECISION_MODEL_BASE_URL=https://api.liquid.ai/decisions
# HINDSIGHT_API_DECISION_MODEL_MODEL=d1.1
# HINDSIGHT_API_DECISION_MODEL_API_KEY=replace-with-your-decision-model-api-key
# HINDSIGHT_API_DECISION_MODEL_TOKENIZER=o200k_base

# Optional recall decision settings.
# HINDSIGHT_API_RECALL_DECISION_MODEL_PRUNE=true
# HINDSIGHT_API_RECALL_DECISION_MODEL_DEDUP=true
# HINDSIGHT_API_RECALL_DECISION_MODEL_PROVIDER=none

# Optional container proxies; use an endpoint reachable from Docker.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Native settings depend on the chosen Hindsight image/provider. These are
# configuration examples, not defaults or a compatibility guarantee.
